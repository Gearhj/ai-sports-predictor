# FD1 content revisions hash raw Python bytes; keep them stable across platforms.
/.gitattributes text eol=lf
/server/**/*.py text eol=lf
/docs/contracts/SPORTS_IDENTITY_BRIDGE_V1.md text eol=lf
/docs/contracts/SPORTS_IDENTITY_BRIDGE_V1.schema.json text eol=lf
/docs/GATE_3C_X2_SPORTS_IDENTITY_BRIDGE_REPORT.md text eol=lf

# The finalized X2 publishing revision hashes these exact wrapper bytes.
/server/app/gen2/exchange/identity_bridge_publisher/__init__.py whitespace=-blank-at-eof
/server/app/gen2/exchange/identity_bridge_publisher/__main__.py whitespace=-blank-at-eof
/server/app/gen2/exchange/identity_bridge_validator/__init__.py whitespace=-blank-at-eof

# These two finalized evidence files contain intentional end-of-line spaces.
/server/app/gen2/fd1_recovery.py whitespace=-blank-at-eol
/docs/GATE_3C_FD1_INTERRUPTED_EXECUTION_REPORT.md text eol=lf whitespace=-blank-at-eol

# Shell hook installer runs under sh, which rejects CRLF.
/scripts/*.sh text eol=lf

# Model Studio market-probability contract fixtures are hash-verified byte for byte.
/server/tests/fixtures/market_probability_contract_v1/** -text
