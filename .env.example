# PostgreSQL connection used by the API. Docker Compose value shown.
DATABASE_URL=postgresql+psycopg://asp:REDACTED-CREDENTIAL@localhost:5433/asp

# Paste your personal key only into .env. Never commit a populated value.
THE_ODDS_API_KEY=

# Odds polling is off by default to protect limited API quota.
ODDS_POLLING_ENABLED=false
ODDS_POLL_INTERVAL_MINUTES=60
ODDS_MARKETS=h2h,spreads,totals
ODDS_REGIONS=us
ODDS_MANUAL_COOLDOWN_MINUTES=5
ODDS_QUOTA_FLOOR=10
# Maximum explicit provider requests ASP may reserve per UTC day. Gate 2 uses
# one controlled request; recurring polling remains disabled.
ODDS_DAILY_REQUEST_BUDGET=1

# Open-Meteo requires no key for the initial development configuration.
OPEN_METEO_ENABLED=true

# Baseball Savant CSV access is isolated and off until source terms/schema are reviewed.
STATCAST_ENABLED=false

# Optional future narrative provider; deterministic templates work without it.
LLM_PROVIDER=
LLM_API_KEY=

# Enables deliberate development-only demo tooling. API failures never activate demo.
DEMO_MODE=true
APP_ENV=development
DISPLAY_TIMEZONE=America/New_York

# Replace for any shared or production deployment (minimum 32 random characters).
SECRET_KEY=change-me-before-any-shared-deployment

# Browser/API origins for native local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Feature flags and model/job controls.
ENABLE_ARBITRAGE_ANALYTICS=false
OFFICIAL_POSITIONS_ENABLED=false
OFFICIAL_MAX_STAKE_PERCENTAGE=0.025
SIMULATION_DRAWS=20000
FORECAST_MIN_READINESS=55
SCHEDULER_ENABLED=false
# Future production-only dispatcher. The Gate 2 classifier is active, but no
# event-relative background provider schedule starts by default.
EVENT_RELATIVE_SCHEDULER_ENABLED=false

# Initial administrator account created by the seed command. Change locally.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REDACTED-CREDENTIAL

# Frontend API origin, consumed by Vite.
VITE_API_URL=http://localhost:8000/api/v1
