{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ASP_MARKET_PROBABILITY_REQUEST_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "populationBinding", "legs"],
  "properties": {
    "schemaVersion": {"const": "ASP_MARKET_PROBABILITY_REQUEST_V1"},
    "populationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sport", "gameId", "forecastId", "modelId", "configurationId", "packageSha256", "populationSha256", "drawCount"],
      "properties": {
        "sport": {"enum": ["MLB", "NFL", "NBA", "CFB"]},
        "gameId": {"type": "string", "minLength": 1},
        "forecastId": {"type": "string", "minLength": 1},
        "modelId": {"type": "string", "minLength": 1},
        "configurationId": {"type": "string", "minLength": 1},
        "packageSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "populationSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "drawCount": {"type": "integer", "minimum": 1}
      }
    },
    "legs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["market", "selection"], "properties": {"market": {"const": "MONEYLINE"}, "selection": {"enum": ["HOME", "AWAY", "TIE"]}, "tieSettlement": {"enum": ["PUSH", "LOSS", "VOID"]}}},
          {"type": "object", "additionalProperties": false, "required": ["market", "selection", "line"], "properties": {"market": {"const": "SPREAD"}, "selection": {"enum": ["HOME", "AWAY"]}, "line": {"type": "number"}}},
          {"type": "object", "additionalProperties": false, "required": ["market", "selection", "line"], "properties": {"market": {"const": "TOTAL"}, "selection": {"enum": ["OVER", "UNDER"]}, "line": {"type": "number"}}}
        ]
      }
    },
    "crossGameMode": {"enum": ["REJECT", "INDEPENDENCE_ASSUMPTION"]}
  }
}
